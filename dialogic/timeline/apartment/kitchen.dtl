	leave alice
	alice: (suspira) Vamos, Alice. No queda otra. Voy a tener que pedir a domicilio en la computadora. #id:81
	[signal arg="step_2"]
elif {GameManager.quest_step} == 2.0:
	alice: Sigo sin encontrar nada... No sé por qué sigo mirando. Ya sé que no hay comida. #id:82
	[signal arg="sfx:meow"]
