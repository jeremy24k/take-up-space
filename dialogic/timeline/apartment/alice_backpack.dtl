if {GameManager.quest_step} == 3.0:
	if GameManager.has_all_prep_items() == false:
		if GameManager.prep_items_unlocked == false:
			alice: Mochila... lista.
			join alice (nervous) leftmost
			alice: (revisa el interior) Auriculares... no están.
			alice: Cartera... no está.
			alice: (mira sus pies descalzos) Zapatos... tampoco.
			alice: Voy a tener que buscarlos.
			alice: Los auriculares suelen estar en mi habitación... La cartera, por la cocina...
			alice: Y los zapatos...[pause=0.8] Ahora que lo pienso... no sé dónde están.
			leave alice
			alice: Bueno. Empezaré a buscar.
			[signal arg="prep_items_unlocked"]
		else:
			alice: (vuelve a mirar dentro de la mochila) Todavía me falta...
			if GameManager.is_item_collected("alice_headphones") == false:
				alice: ...los auriculares.
			if GameManager.is_item_collected("alice_wallet") == false:
				alice: ...la cartera.
			if GameManager.is_item_collected("alice_shoes") == false:
				alice: ...los zapatos.
	else:
		alice: (se cuelga la mochila) Al fin tengo todo. Ok... es hora de irme.
		join alice (worried) leftmost
		alice: Ojalá me emocionara.
		alice: Quizás, si espero un poco...
		(Wilson maúlla, impaciente.)
		update alice (neutral)
		alice: No. Wilson me necesita. Lo voy a hacer.
		update alice (nervous)
		alice: Pero antes... (mira hacia el baño) un par de frases frente al espejo.
		alice: Por si alguien me habla. Por si acaso.
		leave alice
		[signal arg="item_picked:alice_backpack"]
		[signal arg="step_4"]
else:
	alice: Mi mochila... No necesito usarla ahora.
	alice: No me gustaría salir hoy.
