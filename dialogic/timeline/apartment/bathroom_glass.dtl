if GameManager.mirror_practice_done:
	alice: (mira su reflejo un segundo) Ya. Basta de practicar.
	alice: Wilson está esperando.
elif {GameManager.quest_step} >= 4.0:
	if GameManager.mirror_seen:
		alice: (vuelve al espejo) Hola otra vez, Alice.
	else:
		alice: (se pone frente al espejo del lavamanos) Hola, Alice.
	join alice (nervous) leftmost
	alice: (respira hondo) Vale. Un par de frases. Como si fuera de verdad.
	alice: Primero algo fácil. Entro a una tienda y...
	leave alice
	[signal arg="anxiety_puzzle:practice_store"]
	if {anxiety_result} == "ask":
		alice: ¿Tienen comida para gatos?
		join alice (relaxed) leftmost
		alice: (asiente a su reflejo) Eso no estuvo tan mal.
	else:
		alice: (abre la boca... y la vuelve a cerrar)
		join alice (nervous) leftmost
		alice: (se tapa la cara) Vamos, Alice. Era una frase.
	alice: Ahora... preguntar cómo llegar al metro. Por si me pierdo.
	leave alice
	[signal arg="anxiety_puzzle:practice_directions"]
	if {anxiety_result} == "ask":
		alice: Perdone, ¿dónde está el metro?
		join alice (relaxed) leftmost
		alice: (se endereza) Clara. Educada. Bien.
	elif {anxiety_result} == "fumble":
		alice: ¿Dónde estoy yo?
		join alice (relaxed) leftmost
		alice: (se ríe sola) No. Así no se pregunta.
	else:
		alice: (se queda callada)
		join alice (nervous) leftmost
		alice: Ni frente al espejo me sale...
	alice: Y si alguien me pregunta...
	update alice (worried)
	alice: "¿Estás bien?"
	leave alice
	[signal arg="anxiety_puzzle:practice_are_you_ok"]
	if {anxiety_result} == "truth":
		alice: No mucho, la verdad.
		join alice (shocked) leftmost
		alice: (sorprendida de sí misma) Al espejo sí se lo puedo decir.
	elif {anxiety_result} == "lie":
		alice: Sí, estoy bien.
		join alice (worried) leftmost
		alice: (su reflejo no parece muy convencido)
	else:
		alice: (se queda mirando su reflejo, sin decir nada)
		join alice (worried) leftmost
		alice: ...Callarse también es una respuesta. Supongo.
	update alice (nervous)
	alice: (suspira) Bueno. Con eso alcanza.
	alice: Allá afuera no va a ser igual. Pero algo es algo.
	leave alice
	[signal arg="mirror_practice_done"]
else:
	alice: (se acerca al espejo del lavamanos, mira su reflejo) Hola, Alice.
	join alice (scared) leftmost
	alice: (se inclina un poco más, como si buscara algo en su rostro) Tienes ojeras.
	alice: Otra vez.
	alice: (se endereza y se arregla un mechón de pelo) No dormiste bien, ¿verdad?
	update alice (nervous)
	alice: (suspira) Bueno. Nadie va a mirarte tan de cerca hoy.
	alice: O al menos eso espero.
	leave alice
	[signal arg="mirror_seen"]
