if {GameManager.quest_step} == 0.0:
	alice: El plato de Wilson... #id:ce
	join alice (worried) leftmost
	alice: (lo ve vacío) Está vacío. Tengo que buscar algo en la cocina. #id:cf
	[signal arg="sfx:meow"]
	(Wilson la sigue y maúlla detrás de ella, como diciendo "ya lo sabía".) #id:d0
	leave alice
	[signal arg="step_1"]
	[signal arg="wilson_start_follow"]
elif {GameManager.quest_step}  ==  1.0:
	alice: El plato de Wilson... Ya lo revisé antes. Está vacío. #id:d1
	alice: Tengo que ir a la cocina a buscar algo. #id:d2
	[signal arg="sfx:meow"]
	(Wilson maúlla desde el suelo, como si la estuviera apurando.) #id:d3
	alice: Ya voy, ya voy. #id:d4
else:
	alice: El plato de Wilson... #id:d5
	alice: Está vacío. #id:d6