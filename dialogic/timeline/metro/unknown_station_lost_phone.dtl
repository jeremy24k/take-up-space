[signal arg="no_phone"]
update alice (scared)
alice: No.[pause=0.5] No, no, no... #id:176
alice: (mira hacia las vías) Se fue. #id:177
alice: Lo dejé en el tren. #id:178
update alice (worried)
alice: ...[pause=0.8] Genial, Alice. #id:179
alice: ¿Y ahora qué hago? #id:17a
leave alice